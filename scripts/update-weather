#!/usr/bin/env python3
"""Write the static day forecast into index.html.

No browser calls the weather API. Run from the repo root:

    python3 scripts/update-weather

Hourly Open-Meteo data is grouped into morning (until 12:00), 12:00–15:00,
15:00–18:00 and 18:00+. Times are local to that day's place. The stamp is NZDT.
Wind is already in m/s (wind_speed_unit=ms). Days the model does not cover yet
are stored as missing and the page shows "prognoos veel puudub".
"""
from __future__ import annotations

import json
import sys
import urllib.request
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ROOT = Path(__file__).resolve().parents[1]
HTML = ROOT / "index.html"
START = "/* WEATHER:START */"
END = "/* WEATHER:END */"
NZ = "Pacific/Auckland"
MEL = "Australia/Melbourne"

# One forecast place per trip day. Melbourne uses Australia/Melbourne so the
# blocks match the local clock; everything else is Pacific/Auckland.
PLACES = [
    ("14.11", "Melbourne", -37.7841, 144.9515, MEL),
    ("15.11", "Tekapo", -44.0047, 170.4846, NZ),
    ("16.11", "Tekapo", -44.0047, 170.4846, NZ),
    ("17.11", "Aoraki / Mt Cook", -43.735, 170.096, NZ),
    ("18.11", "Wanaka", -44.697, 169.127, NZ),
    ("19.11", "Wanaka", -44.697, 169.127, NZ),
    ("20.11", "Wanaka", -44.697, 169.127, NZ),
    ("21.11", "Te Anau", -45.42, 167.711, NZ),
    ("22.11", "Milford Sound", -44.6695, 167.924, NZ),
    ("23.11", "Wanaka", -44.697, 169.127, NZ),
    ("24.11", "Fox Glacier", -43.463, 170.019, NZ),
    ("25.11", "Okarito", -43.222, 170.162, NZ),
    ("26.11", "Hokitika", -42.706, 170.966, NZ),
    ("27.11", "Hanmer Springs", -42.518, 172.835, NZ),
    ("28.11", "Kaikōura", -42.399, 173.68, NZ),
    ("29.11", "Christchurch", -43.4894, 172.532, NZ),
    ("30.11", "Melbourne", -37.8624, 144.9055, MEL),
]
BLOCKS = (("am", 0, 12), ("mid", 12, 15), ("aft", 15, 18), ("eve", 18, 24))


def get(url: str) -> dict:
    req = urllib.request.Request(url, headers={"User-Agent": "nztravel-update-weather"})
    with urllib.request.urlopen(req, timeout=60) as res:
        return json.load(res)


def fetch(points: list[tuple], tz: str) -> list[dict]:
    lat = ",".join(str(p[2]) for p in points)
    lon = ",".join(str(p[3]) for p in points)
    url = (
        "https://api.open-meteo.com/v1/forecast"
        f"?latitude={lat}&longitude={lon}"
        "&hourly=temperature_2m,precipitation_probability,precipitation,weather_code,wind_speed_10m"
        f"&timezone={tz.replace('/', '%2F')}&forecast_days=16&wind_speed_unit=ms"
    )
    data = get(url)
    return data if isinstance(data, list) else [data]


def day_key(iso: str) -> str:
    y, m, d = iso.split("-")
    return f"{d}.{m}"


def aggregate(hours: list[dict]) -> dict | None:
    temps = [h["temp"] for h in hours if h["temp"] is not None]
    if not temps:
        return None
    wet = [h for h in hours if (h["mm"] or 0) > 0 and h["code"] is not None]
    pool = wet or [h for h in hours if h["code"] is not None]
    code = max(pool, key=lambda h: h["code"] or 0)["code"] if pool else None
    pops = [h["pop"] for h in hours if h["pop"] is not None]
    winds = [h["wind"] for h in hours if h["wind"] is not None]
    mm = sum(h["mm"] or 0 for h in hours)
    return {
        "temp": int(round(sum(temps) / len(temps))),
        "code": None if code is None else int(code),
        "pop": None if not pops else int(round(max(pops))),
        "mm": round(mm, 1),
        "wind": None if not winds else round(max(winds), 1),
    }


def blocks_for(hourly: dict, iso: str) -> list[dict] | None:
    times = hourly.get("time") or []
    rows = []
    for i, stamp in enumerate(times):
        if not stamp.startswith(iso):
            continue
        hour = int(stamp[11:13])
        rows.append({
            "hour": hour,
            "temp": hourly["temperature_2m"][i],
            "pop": hourly["precipitation_probability"][i],
            "mm": hourly["precipitation"][i],
            "code": hourly["weather_code"][i],
            "wind": hourly["wind_speed_10m"][i],
        })
    if not rows:
        return None
    out = []
    for bid, start, end in BLOCKS:
        chunk = [h for h in rows if start <= h["hour"] < end]
        block = aggregate(chunk)
        if not block:
            return None
        block["id"] = bid
        out.append(block)
    return out


def main() -> int:
    text = HTML.read_text(encoding="utf-8")
    if START not in text or END not in text:
        print("weather markers missing from index.html", file=sys.stderr)
        return 1
    by_tz: dict[str, list] = {}
    for place in PLACES:
        by_tz.setdefault(place[4], []).append(place)
    series: dict[tuple, dict] = {}
    first_dates = []
    for tz, points in by_tz.items():
        payloads = fetch(points, tz)
        if len(payloads) != len(points):
            print(f"unexpected forecast count for {tz}", file=sys.stderr)
            return 1
        for place, payload in zip(points, payloads):
            series[(place[0], tz)] = payload["hourly"]
            times = payload["hourly"]["time"]
            if times:
                first_dates.append(times[0][:10])
    today = min(first_dates) if first_dates else ""
    days = {}
    for date, name, _lat, _lon, tz in PLACES:
        iso = f"2026-{date[3:5]}-{date[0:2]}"
        hourly = series[(date, tz)]
        built = blocks_for(hourly, iso)
        if built is None:
            status = "past" if today and iso < today else "missing"
            days[date] = {"place": name, "status": status}
        else:
            days[date] = {"place": name, "status": "ok", "blocks": built}
    stamp = datetime.now(ZoneInfo(NZ)).strftime("%d.%m.%Y %H:%M")
    payload = {"updated": stamp, "source": "Open-Meteo", "days": days}
    body = "const WX=" + json.dumps(payload, ensure_ascii=False, separators=(",", ":")) + ";"
    pre, rest = text.split(START, 1)
    _old, post = rest.split(END, 1)
    HTML.write_text(pre + START + "\n" + body + "\n" + END + post, encoding="utf-8")
    ok = sum(1 for d in days.values() if d["status"] == "ok")
    print(f"updated {stamp} NZDT · {ok}/{len(days)} days with forecast")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
